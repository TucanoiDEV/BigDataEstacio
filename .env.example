# =============================================================================
# Emprego Agora — variáveis de ambiente
# Copie para `.env` e ajuste. NUNCA versione o arquivo `.env`.
# Valores SEM aspas: o formato serve tanto para dotenv quanto para `docker --env-file`.
# =============================================================================

# URL pública da aplicação (sem barra final). Em produção deve ser https://
APP_URL=http://localhost:3000

# PostgreSQL (docker compose sobe em localhost:5433)
DATABASE_URL=postgresql://emprego:emprego_dev_only@localhost:5433/emprego_agora?schema=public
# Banco usado por testes de integração/E2E (é LIMPO a cada execução)
TEST_DATABASE_URL=postgresql://emprego:emprego_dev_only@localhost:5433/emprego_agora_test?schema=public

# Chave de 32 bytes em base64 usada para cifrar segredos de MFA (AES-256-GCM).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Segredo usado para pseudonimizar IPs e identificadores anônimos em logs (HMAC).
# Gere com o mesmo comando acima.
HASH_PEPPER=

# E-mail (SMTP). Em desenvolvimento, o Mailpit do docker compose captura tudo.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Emprego Agora <nao-responda@localhost>

# Armazenamento PRIVADO de arquivos (currículos, fotos). Fora de /public.
STORAGE_DIR=./storage

# Antivírus (ClamAV via clamd). Em produção, uploads são RECUSADOS se ausente.
# docker compose --profile antivirus up -d
CLAMAV_HOST=
CLAMAV_PORT=3310

# MFA obrigatório para administradores da plataforma. Padrão: true em produção.
REQUIRE_ADMIN_MFA=

# Vagas externas (opcional) — ver docs/VAGAS-REAIS.md. Sem valores, a fonte é ignorada.
# Adzuna: credenciais gratuitas em https://developer.adzuna.com (limite padrão: 250 chamadas/dia).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Termos separados por vírgula (vazio = vagas mais recentes do Brasil). Cada termo consome até ADZUNA_MAX_PAGES chamadas.
ADZUNA_QUERIES=
ADZUNA_MAX_PAGES=4
# Quadros públicos do Greenhouse: token[:Nome exibido], separados por vírgula. Lista testada em docs/VAGAS-REAIS.md.
# Ex.: stone:Stone,quintoandar:QuintoAndar,btgpactual:BTG Pactual,c6bank:C6 Bank,inter:Banco Inter
GREENHOUSE_BOARDS=

# Análise de audiência OPCIONAL (carregada somente após consentimento).
# Deixe vazio para não carregar nenhum script analítico.
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Dados do controlador exibidos nos documentos legais (preencha antes de publicar)
NEXT_PUBLIC_CONTROLLER_NAME=
NEXT_PUBLIC_CONTROLLER_CNPJ=
NEXT_PUBLIC_CONTROLLER_ADDRESS=
NEXT_PUBLIC_DPO_NAME=
NEXT_PUBLIC_DPO_EMAIL=
NEXT_PUBLIC_CONTACT_EMAIL=
