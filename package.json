{
  "name": "emprego-agora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "next build && playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed:demo": "tsx --conditions=react-server prisma/seed.ts",
    "admin:create": "tsx --conditions=react-server scripts/create-admin.ts",
    "jobs:alerts": "tsx --conditions=react-server scripts/jobs.ts alerts",
    "jobs:maintenance": "tsx --conditions=react-server scripts/jobs.ts maintenance",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "d3-geo": "^3.1.1",
    "dotenv": "^18.0.9",
    "file-type": "^22.2.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.2.1",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
